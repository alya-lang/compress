# LZ4 Fast Block Compression and Decompression
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/mem"
import "ffi.alya"
import "types.alya"

# Compresses a byte list using LZ4.
function lz4_compress(bytes)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_lz4_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_lz4_compress(src_ptr, src_len, dst_ptr, p_len)
    free_prepared_input(prep)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "LZ4 compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

# Compresses a string using LZ4.
function lz4_compress_str(text)
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_lz4_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_lz4_compress(src_ptr, src_len, dst_ptr, p_len)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "LZ4 compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

# Decompresses LZ4 data into a byte array.
function lz4_decompress(bytes)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz4_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ4 decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# Decompresses LZ4 data directly into a UTF-8 string.
function lz4_decompress_str(bytes)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz4_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ4 decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end
