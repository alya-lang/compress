## GZIP Compression Module
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## RFC 1952 Gzip compression and decompression with CRC-32 integrity validation.

import "std/mem"
import "ffi.alya" as alya
import "types.alya"

## Compresses a byte array using GZIP (default level 6).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
##
## ### Returns
## Gzip-compressed byte array.
pub function gzip_compress(bytes) -> array
    return gzip_compress_level(bytes, LEVEL_DEFAULT)
end

## Compresses a byte array using GZIP with specified level (1..9).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
## - `level`: Compression level integer (1=fastest, 9=best).
##
## ### Returns
## Gzip-compressed byte array.
pub function gzip_compress_level(bytes, level: int) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_gzip_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_gzip_compress(src_ptr, src_len, dst_ptr, p_len, level)
    free_prepared_input(prep)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "Gzip compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Compresses a string using GZIP (default level 6).
##
## ### Parameters
## - `text`: Target string to compress.
##
## ### Returns
## Gzip-compressed byte array.
pub function gzip_compress_str(text: string) -> array
    return gzip_compress_str_level(text, LEVEL_DEFAULT)
end

## Compresses a string using GZIP with specified level (1..9).
##
## ### Parameters
## - `text`: Target string to compress.
## - `level`: Compression level integer (1..9).
##
## ### Returns
## Gzip-compressed byte array.
pub function gzip_compress_str_level(text: string, level: int) -> array
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_gzip_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_gzip_compress(src_ptr, src_len, dst_ptr, p_len, level)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "Gzip compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Decompresses GZIP-compressed byte array into decompressed byte array.
##
## ### Parameters
## - `bytes`: Gzip-compressed byte array.
##
## ### Returns
## Decompressed byte array.
pub function gzip_decompress(bytes) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_gzip_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "Gzip decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Decompresses GZIP-compressed byte array directly into a UTF-8 string.
##
## ### Parameters
## - `bytes`: Gzip-compressed byte array.
##
## ### Returns
## Decompressed string.
pub function gzip_decompress_str(bytes) -> string
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_gzip_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "Gzip decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end
