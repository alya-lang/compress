# Unified LZ Family Codecs (LZ77, LZ78, LZW, LZ4, LZSS, LZMA, LZMA2, LZJB)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/mem"
import "ffi.alya"
import "types.alya"

# Resolves format identifier integer from string name or returns integer.
function resolve_lz_format(name)
    if name == "lz77"
        return 0
    end
    if name == "lz78"
        return 1
    end
    if name == "lzw"
        return 2
    end
    if name == "lz4"
        return 3
    end
    if name == "lzss"
        return 4
    end
    if name == "lzma"
        return 5
    end
    if name == "lzma2"
        return 6
    end
    if name == "lzjb"
        return 7
    end
    return name
end

function format_from_str(name)
    return resolve_lz_format(name)
end

# Core compressor for byte arrays
function internal_lz_compress(bytes, format)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_compress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ compression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# Core compressor for string input
function internal_lz_compress_str(text, format)
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_compress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ compression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# Core decompressor returning byte arrays
function internal_lz_decompress(bytes, format)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_decompress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# Core decompressor returning UTF-8 strings
function internal_lz_decompress_str(bytes, format)
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_decompress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# --- Generic APIs ---
function lz_compress(bytes, format)
    return internal_lz_compress(bytes, resolve_lz_format(format))
end

function lz_compress_str(text, format)
    return internal_lz_compress_str(text, resolve_lz_format(format))
end

function lz_decompress(bytes, format)
    return internal_lz_decompress(bytes, resolve_lz_format(format))
end

function lz_decompress_str(bytes, format)
    return internal_lz_decompress_str(bytes, resolve_lz_format(format))
end

# --- LZ77 Specific APIs (Format 0) ---
function lz77(bytes)
    return internal_lz_compress(bytes, 0)
end

function lz77_str(text)
    return internal_lz_compress_str(text, 0)
end

function unlz77(bytes)
    return internal_lz_decompress(bytes, 0)
end

function unlz77_str(bytes)
    return internal_lz_decompress_str(bytes, 0)
end

# --- LZ78 Specific APIs (Format 1) ---
function lz78(bytes)
    return internal_lz_compress(bytes, 1)
end

function lz78_str(text)
    return internal_lz_compress_str(text, 1)
end

function unlz78(bytes)
