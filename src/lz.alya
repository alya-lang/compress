## Unified LZ Family Compression Module
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Implements Lempel-Ziv family algorithms: LZ77, LZ78, LZW, LZ4, LZSS, LZMA, LZMA2, LZJB.

import "std/mem"
import "ffi.alya" as alya
import "types.alya"

## Resolves format identifier integer from string name, LzFormat enum, or integer.
##
## ### Parameters
## - `name`: Format identifier string, `LzFormat` enum, or integer ID.
##
## ### Returns
## Integer ID representing the LZ format.
pub function resolve_lz_format(name) -> int
    when name
        is LzFormat.Lz77, "lz77", 0 then return 0
        is LzFormat.Lz78, "lz78", 1 then return 1
        is LzFormat.Lzw, "lzw", 2 then return 2
        is LzFormat.Lz4, "lz4", 3 then return 3
        is LzFormat.Lzss, "lzss", 4 then return 4
        is LzFormat.Lzma, "lzma", 5 then return 5
        is LzFormat.Lzma2, "lzma2", 6 then return 6
        is LzFormat.Lzjb, "lzjb", 7 then return 7
        else return name
    end
end

## Alias for `resolve_lz_format`.
##
## ### Parameters
## - `name`: Format identifier string or integer ID.
##
## ### Returns
## Integer ID representing the LZ format.
pub function format_from_str(name) -> int
    return resolve_lz_format(name)
end

## Core compressor for byte arrays.
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
## - `format`: Integer format code.
##
## ### Returns
## Compressed byte array.
pub function internal_lz_compress(bytes, format: int) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_compress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ compression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Core compressor for string input.
##
## ### Parameters
## - `text`: String to compress.
## - `format`: Integer format code.
##
## ### Returns
## Compressed byte array.
pub function internal_lz_compress_str(text: str, format: int) -> array
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_compress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ compression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Core decompressor returning byte arrays.
##
## ### Parameters
## - `bytes`: Compressed byte array.
## - `format`: Integer format code.
##
## ### Returns
## Decompressed byte array.
pub function internal_lz_decompress(bytes, format: int) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_decompress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Core decompressor returning UTF-8 strings.
##
## ### Parameters
## - `bytes`: Compressed byte array.
## - `format`: Integer format code.
##
## ### Returns
## Decompressed string.
pub function internal_lz_decompress_str(bytes, format: int) -> str
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_lz_decompress(format, src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "LZ decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

# --- Generic APIs ---

## Compresses byte data using the requested LZ format.
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
## - `format`: Format name string (e.g. `"lz77"`, `"lzw"`) or format ID.
##
## ### Returns
## Compressed byte array.
pub function lz_compress(bytes, format) -> array
    return internal_lz_compress(bytes, resolve_lz_format(format))
end

## Compresses string data using the requested LZ format.
##
## ### Parameters
## - `text`: String to compress.
## - `format`: Format name string or format ID.
##
## ### Returns
## Compressed byte array.
pub function lz_compress_str(text: str, format) -> array
    return internal_lz_compress_str(text, resolve_lz_format(format))
end

## Decompresses byte data using the requested LZ format.
##
## ### Parameters
## - `bytes`: Compressed byte array.
## - `format`: Format name string or format ID.
##
## ### Returns
## Decompressed byte array.
pub function lz_decompress(bytes, format) -> array
    return internal_lz_decompress(bytes, resolve_lz_format(format))
end

## Decompresses byte data into a string using the requested LZ format.
##
## ### Parameters
## - `bytes`: Compressed byte array.
## - `format`: Format name string or format ID.
##
## ### Returns
## Decompressed string.
pub function lz_decompress_str(bytes, format) -> str
    return internal_lz_decompress_str(bytes, resolve_lz_format(format))
end

# --- LZ77 Specific APIs (Format 0) ---

## Compresses byte data using LZ77.
pub function lz77(bytes) -> array
    return internal_lz_compress(bytes, 0)
end

## Compresses string data using LZ77.
pub function lz77_str(text: str) -> array
    return internal_lz_compress_str(text, 0)
end

## Decompresses LZ77 byte data into a byte array.
pub function unlz77(bytes) -> array
    return internal_lz_decompress(bytes, 0)
end

## Decompresses LZ77 byte data directly into a string.
pub function unlz77_str(bytes) -> str
    return internal_lz_decompress_str(bytes, 0)
end

