## Zstandard (ZSTD) Compression Module
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-performance, real-time compression algorithm providing scalable ratios.

import "std/mem"
import "ffi.alya" as alya
import "types.alya"

pub const ZSTD_LEVEL_DEFAULT = 3
pub const ZSTD_LEVEL_FASTEST = 1
pub const ZSTD_LEVEL_MAX = 22

## Compresses a byte array using Zstandard (default level 3).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
##
## ### Returns
## Compressed byte array.
pub function zstd_compress(bytes) -> array
    return zstd_compress_level(bytes, ZSTD_LEVEL_DEFAULT)
end

## Compresses a byte array using Zstandard with specified level (1..22).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
## - `level`: Compression level integer (1=fastest, 22=ultra).
##
## ### Returns
## Compressed byte array.
pub function zstd_compress_level(bytes, level: int) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_zstd_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_zstd_compress(src_ptr, src_len, dst_ptr, p_len, level)
    free_prepared_input(prep)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "ZSTD compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Compresses a string using Zstandard (default level 3).
##
## ### Parameters
## - `text`: String to compress.
##
## ### Returns
## Compressed byte array.
pub function zstd_compress_str(text: str) -> array
    return zstd_compress_str_level(text, ZSTD_LEVEL_DEFAULT)
end

## Compresses a string using Zstandard with specified level (1..22).
##
## ### Parameters
## - `text`: String to compress.
## - `level`: Compression level integer (1=fastest, 22=ultra).
##
## ### Returns
## Compressed byte array.
pub function zstd_compress_str_level(text: str, level: int) -> array
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_zstd_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_zstd_compress(src_ptr, src_len, dst_ptr, p_len, level)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "ZSTD compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Decompresses Zstandard data into a byte array.
##
## ### Parameters
## - `bytes`: Compressed Zstandard byte array.
##
## ### Returns
## Decompressed byte array.
pub function zstd_decompress(bytes) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_zstd_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "ZSTD decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Decompresses Zstandard data directly into a UTF-8 string.
##
## ### Parameters
## - `bytes`: Compressed Zstandard byte array.
##
## ### Returns
## Decompressed string.
pub function zstd_decompress_str(bytes) -> str
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_zstd_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "ZSTD decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end
