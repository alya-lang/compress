# Huffman Coding & Canonical Compression Algorithm
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

pub function huffman_compress(text)
    let tlen = len(text)
    if tlen == 0
        return []
    end

    # 1. Frequency count
    let freq = []
    let i = 0
    while i < 256
        freq.push(0)
        i += 1
    end

    i = 0
    while i < tlen
        let c = ord(char_at(text, i))
        freq[c] = freq[c] + 1
        i += 1
    end

    # 2. Build initial nodes: [freq, symbol, left_idx, right_idx]
    let nodes = []
    let active = []
    i = 0
    while i < 256
        if freq[i] > 0
            let node_idx = len(nodes)
            nodes.push([freq[i], i, -1, -1])
            active.push(node_idx)
        end
        i += 1
    end

    # Handle special case of single distinct character
    if len(active) == 1
        let single_sym = nodes[active[0]][1]
        let res = [65, 72, 85, 70, 1, single_sym] # Magic + 1 symbol flag
        # 4 bytes for length
        res.push(bit_and(bit_shr(tlen, 24), 255))
        res.push(bit_and(bit_shr(tlen, 16), 255))
        res.push(bit_and(bit_shr(tlen, 8), 255))
        res.push(bit_and(tlen, 255))
        return res
    end

    # 3. Repeatedly combine lowest two nodes
    while len(active) > 1
        # Find min 1
        let min1_pos = 0
        let min1_idx = active[0]
        let min1_freq = nodes[min1_idx][0]
        let p = 1
        while p < len(active)
            let cur_idx = active[p]
            if nodes[cur_idx][0] < min1_freq
                min1_freq = nodes[cur_idx][0]
                min1_idx = cur_idx
                min1_pos = p
            end
            p += 1
        end

        # Remove min1 using fast swap-pop
        let last1 = active.pop()
        if min1_pos < len(active)
            active[min1_pos] = last1
        end

        # Find min 2
        let min2_pos = 0
        let min2_idx = active[0]
        let min2_freq = nodes[min2_idx][0]
        p = 1
        while p < len(active)
            let cur_idx = active[p]
            if nodes[cur_idx][0] < min2_freq
                min2_freq = nodes[cur_idx][0]
                min2_idx = cur_idx
                min2_pos = p
            end
            p += 1
        end

        # Remove min2 using fast swap-pop
        let last2 = active.pop()
        if min2_pos < len(active)
            active[min2_pos] = last2
        end

        # Create parent node
        let parent_idx = len(nodes)
        nodes.push([min1_freq + min2_freq, -1, min1_idx, min2_idx])
        active.push(parent_idx)
    end

    let root = active[0]

    # 4. Generate prefix codes: depth-first search using stack
    let codes = []
    i = 0
    while i < 256
        codes.push("")
        i += 1
    end

    let stack = [[root, ""]]
    while len(stack) > 0
        let item = stack.pop()
        let curr_idx = item[0]
        let curr_code = item[1]
        let curr_node = nodes[curr_idx]

        let left_child = curr_node[2]
        let right_child = curr_node[3]

        if left_child == -1 and right_child == -1
            let sym = curr_node[1]
            codes[sym] = curr_code
        else
            if right_child != -1
                stack.push([right_child, curr_code + "1"])
            end
            if left_child != -1
                stack.push([left_child, curr_code + "0"])
            end
        end
    end

    # 5. Pack bitstream
    let out = [65, 72, 85, 70] # "AHUF" header
    out.push(bit_and(bit_shr(tlen, 24), 255))
    out.push(bit_and(bit_shr(tlen, 16), 255))
    out.push(bit_and(bit_shr(tlen, 8), 255))
    out.push(bit_and(tlen, 255))

    let distinct_count = 0
    i = 0
    while i < 256
        if len(codes[i]) > 0
            distinct_count += 1
        end
        i += 1
    end
    out.push(distinct_count)

    # Output code lengths & symbols
    i = 0
    while i < 256
        if len(codes[i]) > 0
            out.push(i)
            out.push(len(codes[i]))
            let code_int = 0
            let clen = len(codes[i])
            let c_idx = 0
            while c_idx < clen
                if char_at(codes[i], c_idx) == "1"
                    code_int = bit_or(code_int, bit_shl(1, clen - 1 - c_idx))
                end
                c_idx += 1
            end
            out.push(bit_and(bit_shr(code_int, 8), 255))
            out.push(bit_and(code_int, 255))
        end
        i += 1
    end

    # Pack bits of the text
    let curr_byte = 0
    let bit_count = 0

    i = 0
    while i < tlen
        let sym = ord(char_at(text, i))
        let code_str = codes[sym]
        let clen = len(code_str)
        let b = 0
        while b < clen
            curr_byte = bit_shl(curr_byte, 1)
            if char_at(code_str, b) == "1"
                curr_byte = bit_or(curr_byte, 1)
            end
            bit_count += 1
            if bit_count == 8
                out.push(curr_byte)
                curr_byte = 0
                bit_count = 0
            end
            b += 1
        end
        i += 1
    end

    if bit_count > 0
        curr_byte = bit_shl(curr_byte, 8 - bit_count)
        out.push(curr_byte)
    end

    return out
end

pub function huffman_decompress(bytes)
    let blen = len(bytes)
    if blen == 0
        return ""
    end
    if blen < 8 or bytes[0] != 65 or bytes[1] != 72 or bytes[2] != 85 or bytes[3] != 70
        throw "Invalid Huffman compressed data header"
    end

    if bytes[4] == 1 and blen == 10
        let single_sym = chr(bytes[5])
        let uncompressed_len = bit_or(bit_or(bit_shl(bytes[6], 24), bit_shl(bytes[7], 16)), bit_or(bit_shl(bytes[8], 8), bytes[9]))
        let s = ""
        let i = 0
        while i < uncompressed_len
            s = s + single_sym
            i += 1
        end
        return s
    end

    let uncompressed_len = bit_or(bit_or(bit_shl(bytes[4], 24), bit_shl(bytes[5], 16)), bit_or(bit_shl(bytes[6], 8), bytes[7]))
    let distinct_count = bytes[8]
    let offset = 9

    let tree = [[-1, -1, -1]]

    let sym_idx = 0
    while sym_idx < distinct_count
        let sym = bytes[offset]
        let code_len = bytes[offset + 1]
        let code_hi = bytes[offset + 2]
        let code_lo = bytes[offset + 3]
        let code_int = bit_or(bit_shl(code_hi, 8), code_lo)
        offset += 4

        let curr = 0
        let bit_pos = code_len - 1
        while bit_pos >= 0
            let bit_val = bit_and(bit_shr(code_int, bit_pos), 1)
            if bit_val == 0
                if tree[curr][1] == -1
                    let new_node = len(tree)
                    tree.push([-1, -1, -1])
                    tree[curr][1] = new_node
                end
                curr = tree[curr][1]
            else
                if tree[curr][2] == -1
                    let new_node = len(tree)
                    tree.push([-1, -1, -1])
                    tree[curr][2] = new_node
                end
                curr = tree[curr][2]
            end
            bit_pos -= 1
        end
        tree[curr][0] = sym

        sym_idx += 1
    end

    # Decode bitstream
    let res = ""
    let curr = 0
    let decoded_count = 0

    while offset < blen and decoded_count < uncompressed_len
        let b = bytes[offset]
        let bit_pos = 7
        while bit_pos >= 0 and decoded_count < uncompressed_len
            let bit_val = bit_and(bit_shr(b, bit_pos), 1)
            if bit_val == 0
                curr = tree[curr][1]
            else
                curr = tree[curr][2]
            end

            if tree[curr][0] != -1
                res = res + chr(tree[curr][0])
                decoded_count += 1
                curr = 0
            end

            bit_pos -= 1
        end
        offset += 1
    end

    return res
end
