## Bzip2 Compression Module
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-ratio lossless block-sorting data compression algorithm based on Burrows-Wheeler transform.

import "std/mem"
import "ffi.alya" as alya
import "types.alya"

pub const BZIP2_LEVEL_DEFAULT = 9
pub const BZIP2_LEVEL_FASTEST = 1
pub const BZIP2_LEVEL_MAX = 9

## Compresses a byte array using bzip2 (default level 9).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
##
## ### Returns
## Compressed byte array.
pub function bzip2_compress(bytes) -> array
    return bzip2_compress_level(bytes, BZIP2_LEVEL_DEFAULT)
end

## Compresses a byte array using bzip2 with the specified block size level (1..9).
##
## ### Parameters
## - `bytes`: Array of byte integers `[0..255]`.
## - `level`: Compression level integer between 1 (fastest, 100k blocks) and 9 (best, 900k blocks).
##
## ### Returns
## Compressed byte array.
pub function bzip2_compress_level(bytes, level: int) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_bzip2_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_bzip2_compress(src_ptr, src_len, dst_ptr, p_len, level)
    free_prepared_input(prep)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "bzip2 compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Compresses a string using bzip2 (default level 9).
##
## ### Parameters
## - `text`: Target string to compress.
##
## ### Returns
## Compressed byte array.
pub function bzip2_compress_str(text) -> array
    return bzip2_compress_str_level(text, BZIP2_LEVEL_DEFAULT)
end

## Compresses a string using bzip2 with specified level (1..9).
##
## ### Parameters
## - `text`: Target string to compress.
## - `level`: Compression level (1..9).
##
## ### Returns
## Compressed byte array.
pub function bzip2_compress_str_level(text, level: int) -> array
    let prep = prepare_string_input(text)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let bound = alya_bzip2_bound(src_len)
    let dst_ptr = alloc(bound + 1)
    let p_len = alloc(8)
    poke_int(p_len, 0, bound)

    let rc = alya_bzip2_compress(src_ptr, src_len, dst_ptr, p_len, level)
    if rc != 0
        free(dst_ptr)
        free(p_len)
        throw "bzip2 compression failed with error code: " + str(rc)
    end

    let out_len = peek_int(p_len, 0)
    free(p_len)
    let result = ptr_to_byte_list(dst_ptr, out_len)
    free(dst_ptr)
    return result
end

## Decompresses bzip2-compressed byte array into decompressed byte array.
##
## ### Parameters
## - `bytes`: Compressed byte array.
##
## ### Returns
## Decompressed byte array.
pub function bzip2_decompress(bytes) -> array
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_bzip2_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "bzip2 decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_byte_list(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end

## Decompresses bzip2-compressed byte array directly into a UTF-8 string.
##
## ### Parameters
## - `bytes`: Compressed byte array.
##
## ### Returns
## Decompressed string.
pub function bzip2_decompress_str(bytes) -> string
    let prep = prepare_bytes_input(bytes)
    let src_ptr = prep[0]
    let src_len = prep[1]

    let p_out_ptr = alloc(8)
    let p_out_len = alloc(8)
    poke_int(p_out_ptr, 0, 0)
    poke_int(p_out_len, 0, 0)

    let rc = alya_bzip2_decompress_auto(src_ptr, src_len, p_out_ptr, p_out_len)
    free_prepared_input(prep)
    if rc != 0
        free(p_out_ptr)
        free(p_out_len)
        throw "bzip2 decompression failed with error code: " + str(rc)
    end

    let out_ptr = peek_int(p_out_ptr, 0)
    let out_len = peek_int(p_out_len, 0)
    free(p_out_ptr)
    free(p_out_len)

    let result = ptr_to_string(out_ptr, out_len)
    alya_free_buffer(out_ptr)
    return result
end
