# compress library
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./core/formatter.alya"

# Public facade functions
function hello(name = "World")
    return core_format_greeting(name)
end

function new_config(name = "World", count = 1)
    return make_config(name, count)
end

import "./ffi.alya"

# Native C FFI helper function
function c_add(a = 0, b = 0)
    return alya_compress_add(a, b)
end
