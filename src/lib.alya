# compress - Comprehensive compression toolkit for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)
#
# Supported Algorithms:
#   - GZIP (RFC 1952) with CRC-32 and headers
#   - ZLIB (RFC 1950) with Adler-32
#   - Raw DEFLATE (RFC 1951)
#   - LZ4 Fast real-time block compression
#   - Google Snappy block compression
#   - CRC-32 and Adler-32 checksums
#   - Hexadecimal encoding & decoding utilities

import "types.alya"
import "deflate.alya"
import "zlib.alya"
import "gzip.alya"
import "lz4.alya"
import "snappy.alya"
import "checksum.alya"

# --- DEFLATE (RFC 1951) ---
function deflate(bytes)
    return deflate_compress(bytes)
end

function deflate_str(text)
    return deflate_compress_str(text)
end

function deflate_level(bytes, level)
    return deflate_compress_level(bytes, level)
end

function deflate_str_level(text, level)
    return deflate_compress_str_level(text, level)
end

function inflate(bytes)
    return deflate_decompress(bytes)
end

function inflate_str(bytes)
    return deflate_decompress_str(bytes)
end

# --- ZLIB (RFC 1950) ---
function zlib(bytes)
    return zlib_compress(bytes)
end

function zlib_str(text)
    return zlib_compress_str(text)
end

function zlib_level(bytes, level)
    return zlib_compress_level(bytes, level)
end

function zlib_str_level(text, level)
    return zlib_compress_str_level(text, level)
end

function unzlib(bytes)
    return zlib_decompress(bytes)
end

function unzlib_str(bytes)
    return zlib_decompress_str(bytes)
end

# --- GZIP (RFC 1952) ---
function gzip(bytes)
    return gzip_compress(bytes)
end

function gzip_str(text)
    return gzip_compress_str(text)
end

function gzip_level(bytes, level)
    return gzip_compress_level(bytes, level)
end

function gzip_str_level(text, level)
    return gzip_compress_str_level(text, level)
end

function gunzip(bytes)
    return gzip_decompress(bytes)
end

function gunzip_str(bytes)
    return gzip_decompress_str(bytes)
end

# --- LZ4 Fast Compression ---
function lz4(bytes)
    return lz4_compress(bytes)
end

function lz4_str(text)
    return lz4_compress_str(text)
end

function unlz4(bytes)
    return lz4_decompress(bytes)
end

function unlz4_str(bytes)
    return lz4_decompress_str(bytes)
end

# --- Google Snappy ---
function snappy(bytes)
    return snappy_compress(bytes)
end

function snappy_str(text)
    return snappy_compress_str(text)
end

function unsnappy(bytes)
    return snappy_decompress(bytes)
end

function unsnappy_str(bytes)
    return snappy_decompress_str(bytes)
end

# --- PACKAGE VERSION ---
function compress_version()
    return "0.1.0"
end
