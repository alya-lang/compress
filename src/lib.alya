# 2. Bzip2 (Burrows-Wheeler)
# ═══════════════════════════════════════════════════════════════

## Compresses a byte array using Bzip2 (default 900k block size).
@cfg(feature = "codecs")
pub function bzip2(bytes) -> array
    return bzip2_compress(bytes)
end

## Compresses a string using Bzip2 (default 900k block size).
@cfg(feature = "codecs")
pub function bzip2_str(text: str) -> array
    return bzip2_compress_str(text)
end

## Compresses a byte array using Bzip2 with specific block size (1..9).
@cfg(feature = "codecs")
pub function bzip2_block(bytes, block_100k: int) -> array
    return bzip2_compress_level(bytes, block_100k)
end

## Compresses a string using Bzip2 with specific block size (1..9).
@cfg(feature = "codecs")
pub function bzip2_str_block(text: str, block_100k: int) -> array
    return bzip2_compress_str_level(text, block_100k)
end

## Alias for `bzip2_block`.
@cfg(feature = "codecs")
pub function bzip2_level(bytes, level: int) -> array
    return bzip2_compress_level(bytes, level)
end

## Alias for `bzip2_str_block`.
@cfg(feature = "codecs")
pub function bzip2_str_level(text: str, level: int) -> array
    return bzip2_compress_str_level(text, level)
end

## Decompresses Bzip2 data into a byte array.
@cfg(feature = "codecs")
pub function unbzip2(bytes) -> array
    return bzip2_decompress(bytes)
end

## Decompresses Bzip2 data directly into a UTF-8 string.
@cfg(feature = "codecs")
pub function unbzip2_str(bytes) -> str
    return bzip2_decompress_str(bytes)
end

