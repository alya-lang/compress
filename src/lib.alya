# compress - Comprehensive compression toolkit for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)
#
# Supported 9 Compression Modules:
#   1. brotli - Google Brotli compression (RFC 7932)
#   2. bzip2  - Burrows-Wheeler bzip2 block compression
#   3. deflate- RFC 1951 raw Deflate
#   4. gzip   - RFC 1952 Gzip with CRC-32 and headers
#   5. lz     - Lempel-Ziv family (lz4, lz77, lz78, lzjb, lzma, lzma2, lzss, lzw)
#   6. snappy - Google Snappy high-throughput block compression
#   7. szip   - Simple ZIP archive management and buffer compression
#   8. zlib   - RFC 1950 Zlib with Adler-32
#   9. zstd   - Meta/Facebook Zstandard scalable compression

import "types.alya"
import "deflate.alya"
import "zlib.alya"
import "gzip.alya"
import "lz4.alya"
import "lz.alya"
import "snappy.alya"
import "zstd.alya"
import "bzip2.alya"
import "brotli.alya"
import "szip.alya"
import "checksum.alya"
import "huffman.alya"

# ═══════════════════════════════════════════════════════════════
# Unified Format Dispatch with Pattern Matching
# ═══════════════════════════════════════════════════════════════

pub function compress_by_format(data, format = CompressionFormat.Gzip, level = CompressionLevel.Default)
    when format
        is CompressionFormat.Deflate, "deflate" then return deflate_level(data, level)
        is CompressionFormat.Zlib, "zlib" then return zlib_level(data, level)
        is CompressionFormat.Gzip, "gzip" then return gzip_level(data, level)
        is CompressionFormat.Lz4, "lz4" then return lz4(data)
        is CompressionFormat.Snappy, "snappy" then return snappy(data)
        is CompressionFormat.Brotli, "brotli" then return brotli_quality(data, level)
        is CompressionFormat.Bzip2, "bzip2" then return bzip2_level(data, level)
        is CompressionFormat.Zstd, "zstd" then return zstd_level(data, level)
        else return gzip(data)
    end
end

pub function decompress_by_format(data, format = CompressionFormat.Gzip)
    when format
        is CompressionFormat.Deflate, "deflate" then return inflate(data)
        is CompressionFormat.Zlib, "zlib" then return unzlib(data)
        is CompressionFormat.Gzip, "gzip" then return gunzip(data)
        is CompressionFormat.Lz4, "lz4" then return unlz4(data)
        is CompressionFormat.Snappy, "snappy" then return unsnappy(data)
        is CompressionFormat.Brotli, "brotli" then return unbrotli(data)
        is CompressionFormat.Bzip2, "bzip2" then return unbzip2(data)
        is CompressionFormat.Zstd, "zstd" then return unzstd(data)
        else return gunzip(data)
    end
end

# --- 1. BROTLI (RFC 7932) ---
pub function brotli(bytes)
    return brotli_compress(bytes)
end

pub function brotli_str(text)
    return brotli_compress_str(text)
end

pub function brotli_quality(bytes, quality)
    return brotli_compress_level(bytes, quality)
end

pub function brotli_str_quality(text, quality)
    return brotli_compress_str_level(text, quality)
end

pub function unbrotli(bytes)
    return brotli_decompress(bytes)
end

pub function unbrotli_str(bytes)
    return brotli_decompress_str(bytes)
end

# --- 2. BZIP2 (Burrows-Wheeler) ---
pub function bzip2(bytes)
    return bzip2_compress(bytes)
end

pub function bzip2_str(text)
    return bzip2_compress_str(text)
end

pub function bzip2_block(bytes, block_100k)
    return bzip2_compress_level(bytes, block_100k)
end

pub function bzip2_str_block(text, block_100k)
    return bzip2_compress_str_level(text, block_100k)
end

pub function bzip2_level(bytes, level)
    return bzip2_compress_level(bytes, level)
end

pub function bzip2_str_level(text, level)
    return bzip2_compress_str_level(text, level)
end

pub function unbzip2(bytes)
    return bzip2_decompress(bytes)
end

pub function unbzip2_str(bytes)
    return bzip2_decompress_str(bytes)
end

