## Compress - Comprehensive Data Compression Toolkit for Alya
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Provides high-performance compression codecs, checksum algorithms, archive
## handling, and unified format dispatching.
##
## ### Supported Algorithms
## - **Brotli** (RFC 7932)
## - **Bzip2** (Burrows-Wheeler block sorting)
## - **DEFLATE** (RFC 1951 raw deflate)
## - **Gzip** (RFC 1952 deflate with gzip headers and CRC-32)
## - **LZ Family** (LZ4, LZ77, LZ78, LZSS, LZW, LZMA, LZMA2, LZJB)
## - **Google Snappy** (framing and raw block compression)
## - **SZIP / ZIP** (in-memory zip and disk archive manipulation)
## - **Zlib** (RFC 1950 deflate with zlib wrapper and Adler-32)
## - **Zstandard** (Scalable real-time compression)
## - **Huffman** (Optimal prefix canonical coder)
## - **Checksums** (CRC-32, Adler-32)

import "types.alya"
@cfg(feature = "codecs")
import "deflate.alya"
@cfg(feature = "codecs")
import "zlib.alya"
@cfg(feature = "codecs")
import "gzip.alya"
@cfg(feature = "codecs")
import "lz4.alya"
@cfg(feature = "codecs")
import "lz.alya"
@cfg(feature = "codecs")
import "snappy.alya"
@cfg(feature = "codecs")
import "zstd.alya"
@cfg(feature = "codecs")
import "bzip2.alya"
@cfg(feature = "codecs")
import "brotli.alya"
@cfg(feature = "codecs")
@cfg(feature = "codecs")
import "szip.alya"
import "checksum.alya"
@cfg(feature = "codecs")
import "huffman.alya"

# ═══════════════════════════════════════════════════════════════
# Unified Format Dispatch
# ═══════════════════════════════════════════════════════════════

# The slim-view stub below reuses these signatures; lint resolves stub
# param locations to the full versions, so this range silences those
# by-design reports in the slim view (inert in the default view).
# alya-lint: disable unused-param
## Compresses input data using the specified compression format and level.
##
## Requires the `codecs` feature (default-on); without it every format
## raises an unsupported-format error (checksums stay available).
##
## ### Parameters
## - `data`: Input byte array or string.
## - `format`: Format identifier (`CompressionFormat` enum or string name).
## - `level`: Compression level preset (`CompressionLevel` or integer).
##
## ### Returns
## Compressed byte array.
@cfg(feature = "codecs")
pub function compress_by_format(data, format = CompressionFormat.Gzip, level = CompressionLevel.Default) -> array
    when format
        is CompressionFormat.Deflate, "deflate" then return deflate_level(data, level)
        is CompressionFormat.Zlib, "zlib" then return zlib_level(data, level)
        is CompressionFormat.Gzip, "gzip" then return gzip_level(data, level)
        is CompressionFormat.Lz4, "lz4" then return lz4(data)
        is CompressionFormat.Snappy, "snappy" then return snappy(data)
        is CompressionFormat.Brotli, "brotli" then return brotli_quality(data, level)
        is CompressionFormat.Bzip2, "bzip2" then return bzip2_level(data, level)
        is CompressionFormat.Zstd, "zstd" then return zstd_level(data, level)
        is CompressionFormat.Huffman, "huffman" then return huffman(data)
        is CompressionFormat.Szip, "szip" then return szip(data)
        is CompressionFormat.Lz77, "lz77" then return lz_compress(data, 0)
        is CompressionFormat.Lz78, "lz78" then return lz_compress(data, 1)
        is CompressionFormat.Lzw, "lzw" then return lz_compress(data, 2)
        is CompressionFormat.Lzss, "lzss" then return lz_compress(data, 4)
        is CompressionFormat.Lzma, "lzma" then return lz_compress(data, 5)
        is CompressionFormat.Lzma2, "lzma2" then return lz_compress(data, 6)
        is CompressionFormat.Lzjb, "lzjb" then return lz_compress(data, 7)
        else return gzip(data)
    end
end

## Slim-view stub: format dispatch without the `codecs` feature.
## Kept so callers get a clear error instead of an undefined reference.
## Params are unused by design (the stub only throws).
@cfg(not(feature = "codecs"))
pub function compress_by_format(data, format = CompressionFormat.Gzip, level = CompressionLevel.Default) -> array
    throw "compress: codecs feature is disabled (rebuild with default features for format dispatch)"
end
# alya-lint: enable unused-param

# Same arrangement as compress_by_format above: silence the slim-view
# stub reports (resolved to the full version's lines) by design.
# alya-lint: disable unused-param
## Decompresses data using the specified compression format.
##
## Requires the `codecs` feature (default-on); without it every format
## raises an unsupported-format error (checksums stay available).
##
## ### Parameters
## - `data`: Compressed byte array.
## - `format`: Format identifier (`CompressionFormat` enum or string name).
##
## ### Returns
## Decompressed byte array.
@cfg(feature = "codecs")
pub function decompress_by_format(data, format = CompressionFormat.Gzip) -> array
    when format
        is CompressionFormat.Deflate, "deflate" then return inflate(data)
        is CompressionFormat.Zlib, "zlib" then return unzlib(data)
        is CompressionFormat.Gzip, "gzip" then return gunzip(data)
        is CompressionFormat.Lz4, "lz4" then return unlz4(data)
        is CompressionFormat.Snappy, "snappy" then return unsnappy(data)
        is CompressionFormat.Brotli, "brotli" then return unbrotli(data)
        is CompressionFormat.Bzip2, "bzip2" then return unbzip2(data)
        is CompressionFormat.Zstd, "zstd" then return unzstd(data)
        is CompressionFormat.Huffman, "huffman" then return bytes_from_string(unhuffman(data))
        is CompressionFormat.Szip, "szip" then return unszip(data)
        is CompressionFormat.Lz77, "lz77" then return lz_decompress(data, 0)
        is CompressionFormat.Lz78, "lz78" then return lz_decompress(data, 1)
        is CompressionFormat.Lzw, "lzw" then return lz_decompress(data, 2)
        is CompressionFormat.Lzss, "lzss" then return lz_decompress(data, 4)
        is CompressionFormat.Lzma, "lzma" then return lz_decompress(data, 5)
        is CompressionFormat.Lzma2, "lzma2" then return lz_decompress(data, 6)
        is CompressionFormat.Lzjb, "lzjb" then return lz_decompress(data, 7)
        else return gunzip(data)
    end
end

## Slim-view stub: format dispatch without the `codecs` feature.
## Kept so callers get a clear error instead of an undefined reference.
## Params are unused by design (the stub only throws).
@cfg(not(feature = "codecs"))
pub function decompress_by_format(data, format = CompressionFormat.Gzip) -> array
    throw "compress: codecs feature is disabled (rebuild with default features for format dispatch)"
end
# alya-lint: enable unused-param

## Computes a checksum for a byte array using CRC-32 or Adler-32.
##
## ### Parameters
## - `bytes`: Byte array integers `[0..255]`.
## - `algorithm`: Checksum algorithm (`ChecksumAlgorithm` enum or string `"crc32"` / `"adler32"`).
##
## ### Returns
## 32-bit unsigned integer checksum.
pub function compute_checksum(bytes, algorithm = ChecksumAlgorithm.Crc32) -> int
    when algorithm
        is ChecksumAlgorithm.Adler32, "adler32" then return adler32(bytes)
        else return crc32(bytes)
    end
end

## Computes a checksum for a text string using CRC-32 or Adler-32.
##
## ### Parameters
## - `text`: Input text string.
## - `algorithm`: Checksum algorithm (`ChecksumAlgorithm` enum or string `"crc32"` / `"adler32"`).
##
## ### Returns
## 32-bit unsigned integer checksum.
pub function compute_checksum_str(text: str, algorithm = ChecksumAlgorithm.Crc32) -> int
    when algorithm
        is ChecksumAlgorithm.Adler32, "adler32" then return adler32_str(text)
        else return crc32_str(text)
    end
end

# ═══════════════════════════════════════════════════════════════
# 1. Brotli (RFC 7932)
# ═══════════════════════════════════════════════════════════════

## Compresses a byte array using Brotli (default quality 11).
@cfg(feature = "codecs")
pub function brotli(bytes) -> array
    return brotli_compress(bytes)
end

## Compresses a string using Brotli (default quality 11).
@cfg(feature = "codecs")
pub function brotli_str(text: str) -> array
    return brotli_compress_str(text)
end

## Compresses a byte array using Brotli with specific quality (0..11).
@cfg(feature = "codecs")
pub function brotli_quality(bytes, quality: int) -> array
    return brotli_compress_level(bytes, quality)
end

## Compresses a string using Brotli with specific quality (0..11).
@cfg(feature = "codecs")
pub function brotli_str_quality(text: str, quality: int) -> array
    return brotli_compress_str_level(text, quality)
end

## Decompresses Brotli data into a byte array.
@cfg(feature = "codecs")
pub function unbrotli(bytes) -> array
    return brotli_decompress(bytes)
end

## Decompresses Brotli data directly into a UTF-8 string.
@cfg(feature = "codecs")
pub function unbrotli_str(bytes) -> str
    return brotli_decompress_str(bytes)
end

