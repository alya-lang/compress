# compress - Comprehensive compression toolkit for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)
#
# Supported 9 Compression Modules:
#   1. brotli - Google Brotli compression (RFC 7932)
#   2. bzip2  - Burrows-Wheeler bzip2 block compression
#   3. deflate- RFC 1951 raw Deflate
#   4. gzip   - RFC 1952 Gzip with CRC-32 and headers
#   5. lz     - Lempel-Ziv family (lz4, lz77, lz78, lzjb, lzma, lzma2, lzss, lzw)
#   6. snappy - Google Snappy high-throughput block compression
#   7. szip   - Simple ZIP archive management and buffer compression
#   8. zlib   - RFC 1950 Zlib with Adler-32
#   9. zstd   - Meta/Facebook Zstandard scalable compression

import "types.alya"
import "deflate.alya"
import "zlib.alya"
import "gzip.alya"
import "lz4.alya"
import "lz.alya"
import "snappy.alya"
import "zstd.alya"
import "bzip2.alya"
import "brotli.alya"
import "szip.alya"
import "checksum.alya"
import "huffman.alya"

# --- 1. BROTLI (RFC 7932) ---
function brotli(bytes)
    return brotli_compress(bytes)
end

function brotli_str(text)
    return brotli_compress_str(text)
end

function brotli_quality(bytes, quality)
    return brotli_compress_level(bytes, quality)
end

function brotli_str_quality(text, quality)
    return brotli_compress_str_level(text, quality)
end

function unbrotli(bytes)
    return brotli_decompress(bytes)
end

function unbrotli_str(bytes)
    return brotli_decompress_str(bytes)
end

# --- 2. BZIP2 (Burrows-Wheeler) ---
function bzip2(bytes)
    return bzip2_compress(bytes)
end

function bzip2_str(text)
    return bzip2_compress_str(text)
end

function bzip2_block(bytes, block_100k)
    return bzip2_compress_level(bytes, block_100k)
end

function bzip2_str_block(text, block_100k)
    return bzip2_compress_str_level(text, block_100k)
end

function bzip2_level(bytes, level)
    return bzip2_compress_level(bytes, level)
end

function bzip2_str_level(text, level)
    return bzip2_compress_str_level(text, level)
end

function unbzip2(bytes)
    return bzip2_decompress(bytes)
end

function unbzip2_str(bytes)
    return bzip2_decompress_str(bytes)
end

# --- 3. DEFLATE (RFC 1951) ---
function deflate(bytes)
    return deflate_compress(bytes)
end

function deflate_str(text)
    return deflate_compress_str(text)
end

function deflate_level(bytes, level)
    return deflate_compress_level(bytes, level)
end

function deflate_str_level(text, level)
    return deflate_compress_str_level(text, level)
end

function inflate(bytes)
    return deflate_decompress(bytes)
end

function inflate_str(bytes)
    return deflate_decompress_str(bytes)
end

# --- 4. GZIP (RFC 1952) ---
function gzip(bytes)
    return gzip_compress(bytes)
end

function gzip_str(text)
    return gzip_compress_str(text)
end

function gzip_level(bytes, level)
    return gzip_compress_level(bytes, level)
end

function gzip_str_level(text, level)
    return gzip_compress_str_level(text, level)
end

function gunzip(bytes)
    return gzip_decompress(bytes)
end

function gunzip_str(bytes)
    return gzip_decompress_str(bytes)
end

# --- 5. LZ FAMILY (LZ4, LZ77, LZ78, LZJB, LZMA, LZMA2, LZSS, LZW) ---

# Native C LZ4 block compressor (ultra-fast 1M+ ops/s)

function lz4(bytes)
    return lz4_compress(bytes)
end

function lz4_str(text)
    return lz4_compress_str(text)
end

function unlz4(bytes)
    return lz4_decompress(bytes)
end

function unlz4_str(bytes)
    return lz4_decompress_str(bytes)
end

# Note: LZ family functions (lz_compress, lz_decompress, lz77, lz78, lzw, lzss, lzma, lzma2, lzjb)
# are automatically exported via `import "lz.alya"`.

# --- 6. SNAPPY ---
function snappy(bytes)
    return snappy_compress(bytes)
end

function snappy_str(text)
    return snappy_compress_str(text)
end

function unsnappy(bytes)
    return snappy_decompress(bytes)
end

function unsnappy_str(bytes)
    return snappy_decompress_str(bytes)
end

# --- 7. SZIP / ZIP ARCHIVE ---
function szip(bytes)
    return szip_compress(bytes)
end

function szip_str(text)
    return szip_compress_str(text)
end

function unszip(bytes)
    return szip_decompress(bytes)
end

function unszip_str(bytes)
    return szip_decompress_str(bytes)
end

# --- 8. ZLIB (RFC 1950) ---
function zlib(bytes)
    return zlib_compress(bytes)
end

function zlib_str(text)
    return zlib_compress_str(text)
end

function zlib_level(bytes, level)
    return zlib_compress_level(bytes, level)
end

function zlib_str_level(text, level)
    return zlib_compress_str_level(text, level)
end

function unzlib(bytes)
    return zlib_decompress(bytes)
end

function unzlib_str(bytes)
    return zlib_decompress_str(bytes)
end

# --- 9. ZSTD (Meta Zstandard) ---
function zstd(bytes)
    return zstd_compress(bytes)
end

function zstd_str(text)
    return zstd_compress_str(text)
end

function zstd_level(bytes, level)
    return zstd_compress_level(bytes, level)
end

function zstd_str_level(text, level)
    return zstd_compress_str_level(text, level)
end

function unzstd(bytes)
    return zstd_decompress(bytes)
end

function unzstd_str(bytes)
    return zstd_decompress_str(bytes)
end

# --- 10. HUFFMAN (Optimal Prefix Codec) ---
function huffman(text)
    return huffman_compress(text)
end

function huffman_str(text)
    return huffman_compress(text)
end

function unhuffman(bytes)
    return huffman_decompress(bytes)
end

function unhuffman_str(bytes)
    return huffman_decompress(bytes)
end
