# Benchmark suite for compress package
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as compress

function main()
    let runner = bench_runner("Compression 9-Module & LZ Variations Micro-Benchmarks")

    let payload = "Alya is a modern, high-performance programming language designed for systems and ecosystem tooling. "
    payload += "Fast execution, direct C FFI, and zero runtime dependencies make it ideal for high throughput services."

    let gz_data = compress::gzip_str(payload)
    let zl_data = compress::zlib_str(payload)
    let def_data = compress::deflate_str(payload)
    let lz_data = compress::lz4_str(payload)
    let snp_data = compress::snappy_str(payload)
    let zst_data = compress::zstd_str(payload)
    let bz_data = compress::bzip2_str(payload)
    let br_data = compress::brotli_str(payload)
    let sz_data = compress::szip_str(payload)
    let lz77_data = compress::lz77_str(payload)
    let lz78_data = compress::lz78_str(payload)
    let lzw_data = compress::lzw_str(payload)
    let lzjb_data = compress::lzjb_str(payload)

    # 1. Gzip Compression (10,000 calls)
    bench_start(runner, 10000)
    let i = 0
    while i < 10000
        compress::gzip_str(payload)
        i += 1
    end
    bench_stop(runner, "gzip_str() 10k calls")

    # 2. Gzip Decompression (10,000 calls)
    bench_start(runner, 10000)
    let gzi = 0
    while gzi < 10000
        compress::gunzip_str(gz_data)
        gzi += 1
    end
    bench_stop(runner, "gunzip_str() 10k calls")

    # 3. Zlib Compression (10,000 calls)
    bench_start(runner, 10000)
    let zi = 0
    while zi < 10000
        compress::zlib_str(payload)
        zi += 1
    end
    bench_stop(runner, "zlib_str() 10k calls")

    # 4. Zlib Decompression (10,000 calls)
    bench_start(runner, 10000)
    let zdi = 0
    while zdi < 10000
        compress::unzlib_str(zl_data)
        zdi += 1
    end
    bench_stop(runner, "unzlib_str() 10k calls")

    # 5. Deflate Compression (10,000 calls)
    bench_start(runner, 10000)
    let di = 0
    while di < 10000
        compress::deflate_str(payload)
        di += 1
    end
    bench_stop(runner, "deflate_str() 10k calls")

    # 6. Deflate Decompression (10,000 calls)
    bench_start(runner, 10000)
    let ddi = 0
    while ddi < 10000
        compress::inflate_str(def_data)
        ddi += 1
    end
    bench_stop(runner, "inflate_str() 10k calls")

    # 7. LZ4 Fast Compression (25,000 calls)
    bench_start(runner, 25000)
    let li = 0
    while li < 25000
        compress::lz4_str(payload)
        li += 1
    end
    bench_stop(runner, "lz4_str() 25k calls")

    # 8. LZ4 Decompression (25,000 calls)
    bench_start(runner, 25000)
    let ldi = 0
    while ldi < 25000
        compress::unlz4_str(lz_data)
        ldi += 1
    end
    bench_stop(runner, "unlz4_str() 25k calls")

    # 9. Snappy Fast Compression (25,000 calls)
    bench_start(runner, 25000)
    let si = 0
    while si < 25000
        compress::snappy_str(payload)
        si += 1
    end
    bench_stop(runner, "snappy_str() 25k calls")

    # 10. Snappy Decompression (25,000 calls)
    bench_start(runner, 25000)
    let sdi = 0
    while sdi < 25000
        compress::unsnappy_str(snp_data)
        sdi += 1
    end
    bench_stop(runner, "unsnappy_str() 25k calls")

    # 11. ZSTD Fast Compression (10,000 calls)
    bench_start(runner, 10000)
    let zsi = 0
    while zsi < 10000
        compress::zstd_str(payload)
        zsi += 1
    end
    bench_stop(runner, "zstd_str() 10k calls")

    # 12. ZSTD Decompression (25,000 calls)
    bench_start(runner, 25000)
    let zsdi = 0
    while zsdi < 25000
        compress::unzstd_str(zst_data)
        zsdi += 1
    end
    bench_stop(runner, "unzstd_str() 25k calls")

    # 13. BZIP2 Compression (2,000 calls)
    bench_start(runner, 2000)
    let bzi = 0
    while bzi < 2000
        compress::bzip2_str(payload)
        bzi += 1
    end
    bench_stop(runner, "bzip2_str() 2k calls")

    # 14. BZIP2 Decompression (5,000 calls)
    bench_start(runner, 5000)
    let bzdi = 0
    while bzdi < 5000
        compress::unbzip2_str(bz_data)
        bzdi += 1
    end
    bench_stop(runner, "unbzip2_str() 5k calls")

    # 15. Brotli Compression (2,000 calls)
    bench_start(runner, 2000)
    let bri = 0
    while bri < 2000
        compress::brotli_str(payload)
        bri += 1
    end
    bench_stop(runner, "brotli_str() 2k calls")

    # 16. Brotli Decompression (10,000 calls)
    bench_start(runner, 10000)
    let brdi = 0
    while brdi < 10000
        compress::unbrotli_str(br_data)
        brdi += 1
    end
    bench_stop(runner, "unbrotli_str() 10k calls")

    # 17. SZIP Buffer Roundtrip (10,000 calls)
    bench_start(runner, 10000)
    let szi = 0
    while szi < 10000
        compress::szip_str(payload)
        szi += 1
    end
    bench_stop(runner, "szip_str() 10k calls")

    # 18. LZ77 Compression (10,000 calls)
    bench_start(runner, 10000)
    let lz77i = 0
    while lz77i < 10000
        compress::lz77_str(payload)
        lz77i += 1
    end
    bench_stop(runner, "lz77_str() 10k calls")

    # 19. LZ77 Decompression (25,000 calls)
    bench_start(runner, 25000)
    let lz77di = 0
    while lz77di < 25000
        compress::unlz77_str(lz77_data)
        lz77di += 1
    end
    bench_stop(runner, "unlz77_str() 25k calls")

    # 20. LZJB Compression (10,000 calls)
    bench_start(runner, 10000)
    let lzjbi = 0
    while lzjbi < 10000
        compress::lzjb_str(payload)
        lzjbi += 1
    end
    bench_stop(runner, "lzjb_str() 10k calls")

    # 21. LZJB Decompression (25,000 calls)
    bench_start(runner, 25000)
    let lzjbdi = 0
    while lzjbdi < 25000
        compress::unlzjb_str(lzjb_data)
        lzjbdi += 1
    end
    bench_stop(runner, "unlzjb_str() 25k calls")

    # 22. LZW Compression (5,000 calls)
    bench_start(runner, 5000)
    let lzwi = 0
    while lzwi < 5000
        compress::lzw_str(payload)
        lzwi += 1
    end
    bench_stop(runner, "lzw_str() 5k calls")

    # 23. LZW Decompression (10,000 calls)
    bench_start(runner, 10000)
    let lzwdi = 0
    while lzwdi < 10000
        compress::unlzw_str(lzw_data)
        lzwdi += 1
    end
    bench_stop(runner, "unlzw_str() 10k calls")

    # 24. CRC-32 Checksum (50,000 calls)
    bench_start(runner, 50000)
    let ci = 0
    while ci < 50000
        compress::crc32_str(payload)
        ci += 1
    end
    bench_stop(runner, "crc32_str() 50k calls")

    # 25. Adler-32 Checksum (50,000 calls)
    bench_start(runner, 50000)
    let ai = 0
    while ai < 50000
        compress::adler32_str(payload)
        ai += 1
    end
    bench_stop(runner, "adler32_str() 50k calls")

    bench_summary(runner)
end

main()
