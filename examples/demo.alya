# Real-world demonstration of all 9 compression modules and LZ variations in Alya
# Supported: Brotli, Bzip2, Deflate, Gzip, LZ (LZ4, LZ77, LZ78, LZJB, LZMA, LZMA2, LZSS, LZW), Snappy, Szip, Zlib, Zstd

import "../src/lib.alya" as compress

function main()
    say "============================================================"
    say "                Alya Compression Toolkit (compress)                 "
    say "       9 Lossless Compression Modules + Full LZ Family      "
    say "============================================================"

    let text = "The Alya Programming Language is built for speed, simplicity, and safety. "
    text += "With a modular standard library, zero-overhead C FFI, and native ecosystem packages, "
    text += "Alya enables high-throughput microservices, developer tooling, and distributed systems."

    let orig_size = len(text)
    say "Original text (" + str(orig_size) + " bytes):"
    say "  \"" + text + "\"\n"

    # 1. Checksums
    let crc = compress::crc32_str(text)
    let adler = compress::adler32_str(text)
    say "[1] Integrity Checksums:"
    say "    CRC-32   : " + str(crc)
    say "    Adler-32 : " + str(adler) + "\n"

    # 2. Brotli (RFC 7932)
    let br = compress::brotli_str(text)
    let br_restored = compress::unbrotli_str(br)
    say "[2] Brotli Compression (RFC 7932):"
    say "    Compressed size: " + str(len(br)) + " bytes"
    say "    Verified match : " + str(br_restored == text) + "\n"

    # 3. Bzip2 (Burrows-Wheeler)
    let bz = compress::bzip2_str(text)
    let bz_restored = compress::unbzip2_str(bz)
    say "[3] Bzip2 Compression:"
    say "    Compressed size: " + str(len(bz)) + " bytes"
    say "    Verified match : " + str(bz_restored == text) + "\n"

    # 4. Raw DEFLATE (RFC 1951)
    let def = compress::deflate_str(text)
    let def_restored = compress::inflate_str(def)
    say "[4] Raw DEFLATE Compression (RFC 1951):"
    say "    Compressed size: " + str(len(def)) + " bytes"
    say "    Verified match : " + str(def_restored == text) + "\n"

    # 5. GZIP (RFC 1952)
    let gz = compress::gzip_str(text)
    let gz_restored = compress::gunzip_str(gz)
    say "[5] GZIP Compression (RFC 1952):"
    say "    Compressed size: " + str(len(gz)) + " bytes"
    say "    Verified match : " + str(gz_restored == text)
    say "    Header Bytes   : ID1=" + str(gz[0]) + ", ID2=" + str(gz[1]) + "\n"

    # 6. LZ Family: LZ4, LZ77, LZ78, LZJB, LZMA, LZMA2, LZSS, LZW
    let lz4 = compress::lz4_str(text)
    let lz77 = compress::lz77_str(text)
    let lz78 = compress::lz78_str(text)
    let lzw = compress::lzw_str(text)
    let lzss = compress::lzss_str(text)
    let lzma = compress::lzma_str(text)
    let lzma2 = compress::lzma2_str(text)
    let lzjb = compress::lzjb_str(text)

    say "[6] LZ Family Variations:"
    say "    - LZ4   : " + str(len(lz4)) + " bytes (Restored: " + str(compress::unlz4_str(lz4) == text) + ")"
    say "    - LZ77  : " + str(len(lz77)) + " bytes (Restored: " + str(compress::unlz77_str(lz77) == text) + ")"
    say "    - LZ78  : " + str(len(lz78)) + " bytes (Restored: " + str(compress::unlz78_str(lz78) == text) + ")"
    say "    - LZW   : " + str(len(lzw)) + " bytes (Restored: " + str(compress::unlzw_str(lzw) == text) + ")"
    say "    - LZSS  : " + str(len(lzss)) + " bytes (Restored: " + str(compress::unlzss_str(lzss) == text) + ")"
    say "    - LZMA  : " + str(len(lzma)) + " bytes (Restored: " + str(compress::unlzma_str(lzma) == text) + ")"
    say "    - LZMA2 : " + str(len(lzma2)) + " bytes (Restored: " + str(compress::unlzma2_str(lzma2) == text) + ")"
    say "    - LZJB  : " + str(len(lzjb)) + " bytes (Restored: " + str(compress::unlzjb_str(lzjb) == text) + ")\n"

    # 7. Google Snappy
    let snp = compress::snappy_str(text)
    let snp_restored = compress::unsnappy_str(snp)
    say "[7] Google Snappy Compression:"
    say "    Compressed size: " + str(len(snp)) + " bytes"
    say "    Verified match : " + str(snp_restored == text) + "\n"

    # 8. SZIP / Simple ZIP Buffer & Archive
    let sz = compress::szip_str(text)
    let sz_restored = compress::unszip_str(sz)
    say "[8] SZIP Buffer Compression:"
    say "    Compressed size: " + str(len(sz)) + " bytes"
    say "    Verified match : " + str(sz_restored == text) + "\n"
    let zip_demo_path = "demo_archive.zip"
    if file_exists(zip_demo_path)
        remove_file(zip_demo_path)
    end
    compress::szip_create(zip_demo_path)
    compress::szip_add_text(zip_demo_path, "alya_info.txt", text)
    let zip_entries = compress::szip_list(zip_demo_path)
    let zip_extracted = compress::szip_extract_text(zip_demo_path, "alya_info.txt")
    if file_exists(zip_demo_path)
        remove_file(zip_demo_path)
    end
    say "[8] SZIP Buffer & ZIP Archive:"
    say "    Buffer comp. size: " + str(len(sz)) + " bytes"
    say "    Archive entries  : " + str(len(zip_entries)) + " file (" + zip_entries[0] + ")"
    say "    Archive extract  : " + str(zip_extracted == text) + "\n"

    # 9. ZLIB (RFC 1950)
    let zl = compress::zlib_str(text)
    let zl_restored = compress::unzlib_str(zl)
    say "[9] ZLIB Compression (RFC 1950):"
    say "    Compressed size: " + str(len(zl)) + " bytes"
    say "    Verified match : " + str(zl_restored == text) + "\n"

    # 10. ZSTD (Zstandard)
    let zst = compress::zstd_str(text)
    let zst_restored = compress::unzstd_str(zst)
    say "[10] Zstandard (ZSTD):"
    say "     Compressed size: " + str(len(zst)) + " bytes"
    say "     Verified match : " + str(zst_restored == text) + "\n"

    # Summary Comparison Table
    say "============================================================"
    say "                      Summary Comparison                    "
    say "============================================================"
    say "  Algorithm     | Original | Compressed | Status"
    say "  --------------+----------+------------+--------"
    say "  Brotli        | " + str(orig_size) + " B    | " + str(len(br)) + " B       | OK"
    say "  Bzip2         | " + str(orig_size) + " B    | " + str(len(bz)) + " B       | OK"
    say "  Raw DEFLATE   | " + str(orig_size) + " B    | " + str(len(def)) + " B       | OK"
    say "  GZIP          | " + str(orig_size) + " B    | " + str(len(gz)) + " B       | OK"
    say "  LZ4           | " + str(orig_size) + " B    | " + str(len(lz4)) + " B       | OK"
    say "  LZ77          | " + str(orig_size) + " B    | " + str(len(lz77)) + " B       | OK"
    say "  LZ78          | " + str(orig_size) + " B    | " + str(len(lz78)) + " B       | OK"
    say "  LZW           | " + str(orig_size) + " B    | " + str(len(lzw)) + " B       | OK"
    say "  LZSS          | " + str(orig_size) + " B    | " + str(len(lzss)) + " B       | OK"
    say "  LZMA          | " + str(orig_size) + " B    | " + str(len(lzma)) + " B       | OK"
    say "  LZMA2         | " + str(orig_size) + " B    | " + str(len(lzma2)) + " B       | OK"
    say "  LZJB          | " + str(orig_size) + " B    | " + str(len(lzjb)) + " B       | OK"
    say "  Snappy        | " + str(orig_size) + " B    | " + str(len(snp)) + " B       | OK"
    say "  SZIP          | " + str(orig_size) + " B    | " + str(len(sz)) + " B       | OK"
    say "  ZLIB          | " + str(orig_size) + " B    | " + str(len(zl)) + " B       | OK"
    say "  ZSTD          | " + str(orig_size) + " B    | " + str(len(zst)) + " B       | OK"
    say "============================================================"
    say "All 16 compression engines/variations and ZIP archive cycles verified!"
end

main()
